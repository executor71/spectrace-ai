POSTGRES_PASSWORD=local_postgres_only
DB_MIGRATION_PASSWORD=local_migration_only
DB_APP_PASSWORD=local_app_only
RAG_DB_PASSWORD=local_rag_reader_only
EVALUATION_DB_PASSWORD=local_evaluation_reader_only

# Optional overrides. Empty values use ai-service/config/embedding.json.
# Changing the model/dimensions/revision also requires a new corpus seed migration.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_REVISION=
EMBEDDING_PROVIDER=

# Phase 3 local analysis LLM (separate from frozen embedding model)
ANALYSIS_LLM_MODEL=qwen2.5:7b-instruct
ANALYSIS_LLM_TIMEOUT_SECONDS=300
ANALYSIS_LLM_THINK=false

# High-level workflow summaries (stdout, KST). Includes no prompt/model response.
WORKFLOW_SUMMARY_LOG=false

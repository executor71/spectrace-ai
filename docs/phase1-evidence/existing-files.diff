+  letter-spacing: 0;
+  font-weight: 600;
+}
+
+h1 em { color: var(--green); font-family: Georgia, serif; font-weight: 400; }
+.lede { max-width: 460px; margin: 0; color: #68736d; font-size: 15px; line-height: 1.9; }
+
+.workspace { border-top: 1px solid var(--ink); }
+.section-heading { display: flex; align-items: end; justify-content: space-between; padding: 24px 0 18px; }
+h2 { margin: 8px 0 0; font-size: 19px; font-weight: 700; }
+.read-only { padding: 6px 8px; border: 1px solid var(--line); color: var(--muted); }
+.service-list { border-top: 1px solid var(--line); }
+
+.service-row {
+  min-height: 82px;
+  display: grid;
+  grid-template-columns: 62px minmax(0, 1fr) auto;
+  align-items: center;
+  border-bottom: 1px solid var(--line);
+  animation: row-in 400ms ease-out both;
+}
+.service-row:nth-child(2) { animation-delay: 80ms; }
+.service-row:nth-child(3) { animation-delay: 160ms; }
+.service-index { color: #9a9f96; }
+.service-name h3 { margin: 0; font-size: 14px; font-weight: 700; }
+.service-name p { margin: 5px 0 0; color: var(--muted); font: 10px var(--mono); }
+.status { display: flex; align-items: center; gap: 8px; color: var(--muted); white-space: nowrap; }
+.status-online { color: var(--green); }
+.status-online .status-dot { background: #3e8b65; }
+.status-offline { color: #a6453c; }
+.status-offline .status-dot { background: #bd594f; }
+.status-managed { color: #68736d; }
+.status-managed .status-dot { background: #c78842; }
+
+.footer {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 28px 0 34px;
+  color: #899088;
+  font-size: 9px;
+}
+
+@keyframes arrive { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes row-in { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: translateX(0); } }
+
+@media (max-width: 600px) {
+  .shell { width: 100%; padding: 0 22px; }
+  .topbar { height: 68px; }
+  .wordmark { gap: 8px; font-size: 9px; }
+  .intro { padding: 60px 0 52px; }
+  h1 { font-size: 44px; }
+  .lede { font-size: 14px; }
+  .service-row { grid-template-columns: 34px minmax(0, 1fr); gap: 4px; padding: 16px 0; }
+  .status { grid-column: 2; margin-top: 10px; }
+  .footer { flex-direction: column; }
+}
